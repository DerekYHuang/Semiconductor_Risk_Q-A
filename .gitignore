# Environments
venv/
__pycache__/
*.pyc

# Raw source documents — large, and mostly re-downloadable from public sources.
# Comment these out if you want to version-control your specific corpus.
data/raw/**/*.pdf
data/raw/**/*.html
data/raw/**/*.htm

# Processed artifacts — regeneratable from raw data via the pipeline scripts
data/processed/parsed/
data/processed/chunks/
data/processed/vector_store/
data/processed/finetune_dataset.jsonl

# Fine-tuned model weights — large binary files, don't belong in git
outputs/finetuned_model/

# OS/editor cruft
.DS_Store
.vscode/
.idea/
